// UC9 - Lista de Exercícios de Fixação - Questão 09
// Tabuada
programa
{
    funcao inicio()
    {
        inteiro numero
        escreva("Digite um número inteiro: ")
        leia(numero)
        para (inteiro i = 1; i <= 10; i++)
            escreva(numero, " x ", i, " = ", numero * i, "\n")
    }
}
