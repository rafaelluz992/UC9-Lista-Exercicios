// UC9 - Lista de Exercícios de Fixação - Questão 08
// Contagem com para
programa
{
    funcao inicio()
    {
        escreva("Contagem de 1 a 50:\n")
        para (inteiro i = 1; i <= 50; i++)
            escreva(i, " ")
        escreva("\nContagem regressiva de 20 a 0:\n")
        para (inteiro i = 20; i >= 0; i = i - 2)
            escreva(i, " ")
        escreva("\n")
    }
}
