// UC9 - Lista de Exercícios de Fixação - Questão 02
// Par ou ímpar
programa
{
    funcao inicio()
    {
        inteiro numero
        escreva("Digite um número inteiro: ")
        leia(numero)
        se (numero % 2 == 0)
            escreva("PAR\n")
        senao
            escreva("ÍMPAR\n")
    }
}
